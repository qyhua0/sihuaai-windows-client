<Window x:Class="Bloghua.AutoClient.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 客服助手 (DB版)" Height="600" Width="900">
    <Grid>
        <TabControl Margin="10">
            <!-- 1. 监控台 -->
            <TabItem Header="运行监控">
                <StackPanel Margin="10">
                    <TextBlock Text="当前状态:" FontWeight="Bold"/>
                    <Label x:Name="lblStatus" Content="停止" Foreground="Red" FontSize="14"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10">
                        <Button Content="启动服务" Click="Start_Click" Width="100" Height="30" Margin="0,0,10,0"/>
                        <Button Content="停止服务" Click="Stop_Click" Width="100" Height="30"/>
                    </StackPanel>
                    <TextBlock Text="实时日志:" Margin="0,10,0,5"/>
                    <TextBox x:Name="txtConsole" Height="300" VerticalScrollBarVisibility="Auto" IsReadOnly="True"/>
                </StackPanel>
            </TabItem>

            <!-- 2. 日志查询与导出 -->
            <TabItem Header="会话记录">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 查询条件 -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="名称:" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtSearchName" Width="100" Margin="5,0,10,0"/>

                        <TextBlock Text="内容:" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtSearchContent" Width="100" Margin="5,0,10,0"/>

                        <DatePicker x:Name="dpStart" Width="100"/>
                        <TextBlock Text="-" VerticalAlignment="Center" Margin="5"/>
                        <DatePicker x:Name="dpEnd" Width="100" Margin="0,0,10,0"/>

                        <Button Content="查询" Click="SearchLog_Click" Width="60"/>
                        <Button Content="导出Excel" Click="Export_Click" Width="80" Margin="10,0,0,0"/>
                    </StackPanel>

                    <!-- 数据表格 -->
                    <DataGrid Grid.Row="1" x:Name="gridLogs" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Binding="{Binding CreatedAt, StringFormat='MM-dd HH:mm:ss'}" Width="120"/>
                            <DataGridTextColumn Header="平台" Binding="{Binding Platform}" Width="60"/>
                            <DataGridTextColumn Header="会话名称" Binding="{Binding SessionName}" Width="100"/>
                            <DataGridTextColumn Header="对方消息" Binding="{Binding RequestContent}" Width="200"/>
                            <DataGridTextColumn Header="AI回复" Binding="{Binding ReplyContent}" Width="200"/>
                            <DataGridTextColumn Header="耗时(ms)" Binding="{Binding TimeTakenMs}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- 3. 配置管理 -->
            <TabItem Header="系统配置">
                <StackPanel Margin="10">
                    <GroupBox Header="全局设置" Margin="0,0,0,10">
                        <StackPanel Margin="5">
                            <CheckBox x:Name="chkAutoSend" Content="开启自动发送 (未勾选则仅粘贴到输入框)" Checked="Config_Changed" Unchecked="Config_Changed"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="授权目标管理 (WeChat/QQ等)">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="5">
                                <TextBox x:Name="txtAddName" Width="100" Margin="0,0,5,0" Tag="名称"/>
                                <TextBox x:Name="txtAddBizId" Width="80" Margin="0,0,5,0" Tag="业务ID"/>
                                <ComboBox x:Name="cmbPlatform" Width="80" SelectedIndex="0" Margin="0,0,5,0">
                                    <ComboBoxItem Content="WeChat"/>
                                    <ComboBoxItem Content="QQ"/>
                                </ComboBox>
                                <Button Content="添加/更新" Click="AddUser_Click" Width="80"/>
                            </StackPanel>

                            <DataGrid Grid.Row="1" x:Name="gridUsers" Height="200" AutoGenerateColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="40"/>
                                    <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="100"/>
                                    <DataGridTextColumn Header="业务ID" Binding="{Binding BusinessId}" Width="100"/>
                                    <DataGridTextColumn Header="平台" Binding="{Binding Platform}" Width="80"/>
                                    <DataGridCheckBoxColumn Header="启用" Binding="{Binding IsEnabled}"/>
                                    <DataGridTemplateColumn Header="操作">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="删除" Click="DeleteUser_Click"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </GroupBox>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>