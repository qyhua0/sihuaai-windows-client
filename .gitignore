## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
[Dd]ebug*/
[Rr]elease*/
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# Visual Studio 2015/2017/2019 cache/options directory
.vs/
.vscode/

# MSTest test Results
[Tt]est[Rr]esult*/
[Tt]est[Rr]esults*.xml
*.VisualState.xml
TestResult.xml

# Build Results of an ATL Project
[Dd]ebugPS/
[Rr]eleasePS/
dlldata.c

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# Files built by Visual Studio
*.dll
*.exe
*.pdb
*.dll.config
*.exe.config
*.ilk
*.meta
*.obj
*.iobj
*.pch
*.ipdb
*.pgc
*.pgd
*.rsp
*.sbr
*.tlb
*.tli
*.tlh
*.tmp
*.tmp_proj
*_wpftmp.csproj
*_wpftmp.vbproj
*.log
*.vspscc
*.vssscc
.builds
*.pidb
*.svclog
*.scc

# Chutzpah Test files
_Chutzpah*

# Visual C++ cache files
ipch/
*.aps
*.ncb
*.opendb
*.opensdf
*.sdf
*.cachefile
*.VC.db
*.VC.VC.opendb

# Visual Studio profiler
*.psess
*.vsp
*.vspx
*.sap

# TFS 2012 Local Workspace
$tf/

# Guidance Automation Toolkit
*.gpState

# ReSharper is a .NET coding add-in
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# JustCode is a .NET coding add-in
.JustCode

# TeamCity is a build add-in
_TeamCity*

# DotCover is a Code Coverage Tool
*.dotCover

# Click-Once
publish/

# Publish Web Output
*.Publish.xml
*.pubxml

# NuGet Packages
*.nupkg
*.nuspec
*.nupkg.metadata
*.nupkg.sha512
*.nupkg.sig
[Nn]uGet/
[Nn]uGet.Config
# The packages folder can be ignored because packages can be restored
# from packages.config or project.json (in .NET Core)
packages/

# Azure Build
*.azurePubxml

# Windows Store app package directories and files
AppPackages/
BundleArtifacts/
Package.StoreAssociation.xml
_pkginfo.txt

# Visual Studio Code
.vscode/

# Others
*.dotCover
*.ncrunchsolution
*.ncrunchproject
*ncrunch*
*NCrunch*
*.crunchproject
*.crunchsolution
*Crunch*
*.cache
*.ilk
*.ilk

# Backup & temp files
*.bak
*.tmp
Thumbs.db

obj/
.editorconfig
doc/
