<Page x:Class="Bloghua.AutoClient.Desktop.Views.MonitoringView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      Title="AI 辅助驾驶">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <!-- 左侧监控 -->
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="3*" />
            <!-- 右侧建议区 -->
        </Grid.ColumnDefinitions>

        <!-- 左侧：控制台与日志 -->
        <StackPanel Grid.Column="0">
            <TextBlock Text="运行状态" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

            <!-- 显示当前识别到的聊天对象 -->
            <!-- 当前检测窗口区域 -->
            <Border Background="#E6F2FF" CornerRadius="4" Padding="10" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="当前检测窗口" FontSize="12" Foreground="Gray"/>
                    <TextBlock x:Name="lblCurrentChat" Text="等待扫描..." FontSize="16" FontWeight="Bold" Foreground="#0078D7" TextTrimming="CharacterEllipsis" Margin="0,0,0,5"/>

                    <!-- 【新增】角色选择下拉框 -->
                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="设定人设：" VerticalAlignment="Center" FontSize="12"/>
                        <ComboBox x:Name="cmbRoles" Grid.Column="1" Margin="5,0,0,0" 
                                  DisplayMemberPath="Name" 
                                  SelectedValuePath="Code"
                                  SelectionChanged="CmbRoles_SelectionChanged"
                                  IsEnabled="False"/>
                        <!-- 默认禁用，识别到人后启用 -->
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 状态显示区域 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <!-- 状态灯 -->
                <Ellipse x:Name="lightStatus" Width="16" Height="16" Fill="Gray" Margin="0,0,10,0"/>

                <!-- 状态文字 (如：思考中) -->
                <TextBlock x:Name="lblStatus" Text="未启动" VerticalAlignment="Center" FontSize="14"/>

                <!-- 【新增】上下文内容显示 (如：针对"..."进行思考) -->
                <!-- TextTrimming="CharacterEllipsis" 实现超长省略 -->
                <!-- MaxWidth="150" 限制最大宽度，防止撑破界面 -->
                <TextBlock x:Name="lblStatusContext" 
                           Text="" 
                           VerticalAlignment="Center" 
                           FontSize="12" 
                           Foreground="Gray" 
                           Margin="10,0,0,0" 
                           TextTrimming="CharacterEllipsis" 
                           MaxWidth="180" 
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                           Visibility="Collapsed"/>
            </StackPanel>

            <!-- 【新增】服务器通讯状态 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <ui:FontIcon x:Name="iconServer" Glyph="&#xE812;" FontSize="16" Foreground="Gray" Margin="0,0,10,0"/>
                <TextBlock Text="服务器通讯：" VerticalAlignment="Center" FontSize="14"/>
                <TextBlock x:Name="lblServerStatus" Text="未检测" VerticalAlignment="Center" FontSize="14" FontWeight="Bold" Foreground="Gray" Margin="5,0,0,0"/>
            </StackPanel>

            <!-- 按钮组 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <!-- 初始状态：启动可用，停止不可用 -->
                <Button x:Name="btnStart" Content="开启辅助" Click="Start_Click" Width="100" Margin="0,0,10,0" IsEnabled="True"/>
                <Button x:Name="btnStop" Content="停止" Click="Stop_Click" Width="100" Background="#E81123" Foreground="White" IsEnabled="False"/>
            </StackPanel>

            <TextBlock Text="系统日志" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtConsole" Height="300" IsReadOnly="True" 
                     VerticalScrollBarVisibility="Auto" AcceptsReturn="True" 
                     FontSize="12" Background="#F5F5F5" BorderThickness="0"/>
        </StackPanel>

        <!-- 右侧：AI 建议回复区 (重构) -->
        <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="💡 AI 建议策略" FontSize="18" FontWeight="Bold" Foreground="#0078D7"/>

                    <!-- 【新增】显示用户原始提问 -->
                    <Border x:Name="borderOriginalQuery" 
                            Background="#FFF4CE" BorderBrush="#FFD54F" BorderThickness="1" 
                            CornerRadius="4" Padding="10" Margin="0,10,0,10" 
                            Visibility="Collapsed">
                        <!-- 默认隐藏，有数据时显示 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:FontIcon Glyph="&#xE8F2;" Foreground="#FF8F00" VerticalAlignment="Top" Margin="0,2,8,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="当前识别到的问题：" FontSize="11" Foreground="#FF8F00" FontWeight="Bold"/>
                                <TextBlock x:Name="lblOriginalQuery" 
                                           Text="..." 
                                           FontSize="13" Foreground="#5D4037" 
                                           TextWrapping="NoWrap" 
                                           TextTrimming="CharacterEllipsis" 
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>


                    <TextBlock Text="请点击下方卡片直接填入输入框" FontSize="12" Foreground="Gray" Margin="0,5,0,10"/>
                </StackPanel>

                <!-- 【核心】建议列表 -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="listSuggestions">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Background="White">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 左侧大区域：点击直接填入 -->
                                        <Button Grid.Column="0" 
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                Background="Transparent" BorderThickness="0"
                                                Click="SuggestionItem_Click" Tag="{Binding content}"
                                                ToolTip="点击直接填入微信输入框 (会自动校验当前窗口)">
                                            <Grid Margin="10">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <!-- 类型标签 -->
                                                <Border Grid.Row="0" HorizontalAlignment="Left" CornerRadius="4" 
                                                        Background="{Binding ColorCode}" Padding="6,2" Margin="0,0,0,8">
                                                    <TextBlock Text="{Binding TypeDisplayName}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                                </Border>

                                                <!-- 内容 -->
                                                <TextBlock Grid.Row="1" Text="{Binding content}" TextWrapping="Wrap" 
                                                           FontSize="14" LineHeight="20" Foreground="#333" TextAlignment="Left"/>
                                            </Grid>
                                        </Button>

                                        <!-- 右侧：复制按钮 -->
                                        <Button Grid.Column="1" Width="40" VerticalAlignment="Stretch"
                                                Background="#F9F9F9" BorderThickness="1,0,0,0" BorderBrush="#F0F0F0"
                                                Click="Copy_Click" Tag="{Binding content}"
                                                ToolTip="仅复制内容到剪贴板">
                                            <ui:SymbolIcon Symbol="Copy"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 如果解析失败或无建议，显示提示 -->
                <TextBlock x:Name="lblNoSuggestion" Grid.Row="1" Text="等待 AI 响应..." 
                           VerticalAlignment="Center" HorizontalAlignment="Center" 
                           Foreground="LightGray" FontSize="20" Visibility="Visible"/>
            </Grid>
        </Border>
    </Grid>
</Page>