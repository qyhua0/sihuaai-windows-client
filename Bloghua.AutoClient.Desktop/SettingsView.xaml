<Page x:Class="Bloghua.AutoClient.Desktop.Views.SettingsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="800"
      Title="系统设置">

    <StackPanel Margin="24">
        <TextBlock Text="全局参数配置" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,20"/>

        <!-- 1. 扫描间隔 -->
        <TextBlock Text="扫描间隔 (秒)" FontWeight="Bold" Margin="0,0,0,5"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
            <Slider x:Name="sliderScan" Minimum="2" Maximum="300" Width="300" TickFrequency="1" IsSnapToTickEnabled="True"/>
            <TextBlock Text="{Binding ElementName=sliderScan, Path=Value}" VerticalAlignment="Center" Margin="10,0"/>
        </StackPanel>

        <!-- 2. 回复等待时间 -->
        <TextBlock Text="回复随机等待时间 (秒)" FontWeight="Bold" Margin="0,0,0,5"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
            <ui:NumberBox x:Name="nbWaitMin" Header="最小等待" Value="2" Minimum="0" SpinButtonPlacementMode="Inline" Width="120" Margin="0,0,20,0"/>
            <ui:NumberBox x:Name="nbWaitMax" Header="最大等待" Value="20" Minimum="0" SpinButtonPlacementMode="Inline" Width="120"/>
        </StackPanel>

        <!-- 3. 自动发送 -->
        <ui:ToggleSwitch x:Name="tsAutoSend" Header="开启全自动发送 (On:回车 / Off:仅粘贴)" Margin="0,0,0,20"/>

        <!-- 保存按钮 -->
        <!-- 使用背景色替代样式，避免报错 -->
        <Button Content="保存全局设置" 
                Click="SaveSettings_Click" 
                Margin="0,0,0,40" 
                Width="200" 
                HorizontalAlignment="Left"
                Background="#0078D7" 
                Foreground="White" 
                FontWeight="Bold"/>

        <!-- 4. 授权目标管理 -->
        <TextBlock Text="授权目标管理" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10"/>

        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <!-- 修复点：使用 ui:ControlHelper.PlaceholderText -->
                <TextBox x:Name="txtAddName" 
                         ui:ControlHelper.PlaceholderText="微信名称/群名" 
                         Width="150" Margin="0,0,10,0"/>

                <TextBox x:Name="txtAddBizId" 
                         ui:ControlHelper.PlaceholderText="业务ID (选填)" 
                         Width="100" Margin="0,0,10,0"/>

                <ComboBox x:Name="cmbPlatform" SelectedIndex="0" Width="100" Margin="0,0,10,0">
                    <ComboBoxItem Content="WeChat"/>
                    <ComboBoxItem Content="QQ"/>
                </ComboBox>
            </StackPanel>
            <Button Grid.Column="1" Content="添加授权" Click="AddUser_Click"/>
        </Grid>

        <DataGrid x:Name="gridUsers" AutoGenerateColumns="False" Height="250" Background="White">
            <DataGrid.Columns>
                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="150"/>
                <DataGridTextColumn Header="业务ID" Binding="{Binding BusinessId}" Width="100"/>
                <DataGridTextColumn Header="平台" Binding="{Binding Platform}" Width="80"/>
                <DataGridTemplateColumn Header="操作">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="删除" Click="DeleteUser_Click" Background="#E81123" Foreground="White"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </StackPanel>
</Page>