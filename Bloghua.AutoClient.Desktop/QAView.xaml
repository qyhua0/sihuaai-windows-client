<Page x:Class="Bloghua.AutoClient.Desktop.Views.QAView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.modernwpf.com/2019"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1000"
      Title="问答库管理">

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <!-- ================= 左侧：列表与工具栏 ================= -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 顶部工具栏 -->
            <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,0,0,12">
                <TextBlock Text="知识库列表" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ui:AutoSuggestBox PlaceholderText="输入问题或答案关键词搜索..."
                                       QueryIcon="Find"
                                       Text="{Binding SearchKeyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       Width="300" HorizontalAlignment="Left">
                        <ui:AutoSuggestBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                        </ui:AutoSuggestBox.InputBindings>
                    </ui:AutoSuggestBox>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="查询" Command="{Binding SearchCommand}" Margin="0,0,8,0"/>

                        <!-- 修复1：使用硬编码颜色代替系统资源 -->
                        <Rectangle Width="1" Height="20" Fill="#E5E5E5" Margin="0,0,8,0" VerticalAlignment="Center"/>

                        <Button ToolTip="导入 Excel" Command="{Binding ImportCommand}" Margin="0,0,8,0">
                            <ui:SymbolIcon Symbol="Upload"/>
                        </Button>

                        <Button ToolTip="导出 Excel" Command="{Binding ExportCommand}">
                            <ui:SymbolIcon Symbol="Download"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- 数据表格 -->
            <!-- 修复2：Background 改为 White -->
            <DataGrid Grid.Row="1" 
                      ItemsSource="{Binding QAList}" 
                      SelectedItem="{Binding SelectedQA, Mode=TwoWay}"
                      AutoGenerateColumns="False" 
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      Background="White">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                    <DataGridTextColumn Header="平台" Binding="{Binding Platform}" Width="80"/>
                    <DataGridTextColumn Header="优先级" Binding="{Binding Priority}" Width="60"/>
                    <DataGridTextColumn Header="问题 (关键词)" Binding="{Binding Question}" Width="200"/>
                    <DataGridTextColumn Header="预设回答" Binding="{Binding Answer}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="MaxHeight" Value="60"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="Gray" Margin="0,8,0,0" FontSize="12"/>
        </Grid>

        <!-- ================= 右侧：编辑表单 ================= -->
        <!-- 修复3：Background 改为浅灰色 #F9F9F9 -->
        <Border Grid.Column="2" 
                Background="#F9F9F9" 
                CornerRadius="8" 
                Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="详情编辑" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,20"/>

                    <TextBlock Text="适用平台" FontWeight="Bold" Margin="0,0,0,8"/>
                    <ComboBox SelectedItem="{Binding EditingPlatform}" HorizontalAlignment="Stretch" Margin="0,0,0,16">
                        <ComboBoxItem Content="WeChat"/>
                        <ComboBoxItem Content="QQ"/>
                        <ComboBoxItem Content="Facebook"/>
                        <ComboBoxItem Content="X"/>
                    </ComboBox>

                    <TextBlock Text="优先级 (数字越大越优先)" FontWeight="Bold" Margin="0,0,0,8"/>
                    <ui:NumberBox Value="{Binding EditingPriority, Mode=TwoWay}" Minimum="0" Maximum="999" SpinButtonPlacementMode="Inline" Margin="0,0,0,16"/>

                    <TextBlock Text="匹配问题 (支持模糊匹配)" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding EditingQuestion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                             Height="80" 
                             TextWrapping="Wrap" 
                             AcceptsReturn="True" 
                             Margin="0,0,0,16"/>

                    <TextBlock Text="回复内容" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding EditingAnswer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                             Height="150" 
                             TextWrapping="Wrap" 
                             AcceptsReturn="True" 
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,0,0,16"/>
                </StackPanel>

                <!-- 底部操作按钮 -->
                <StackPanel Grid.Row="2" Orientation="Vertical">
                    <!-- 修复4：移除 Style，手动设置蓝底白字，消除 AccentButtonStyle 警告 -->
                    <Button Content="保存更改" 
                            Command="{Binding SaveCommand}" 
                            HorizontalAlignment="Stretch" 
                            Background="#0078D7"
                            Foreground="White"
                            FontWeight="Bold"
                            Margin="0,0,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="清空/新建" Command="{Binding ClearSelectionCommand}" HorizontalAlignment="Stretch"/>
                        <Button Grid.Column="2" Content="删除条目" Command="{Binding DeleteCommand}" HorizontalAlignment="Stretch" Background="#E81123" Foreground="White"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>