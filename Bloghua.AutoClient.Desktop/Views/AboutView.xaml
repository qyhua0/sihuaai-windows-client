<Page x:Class="Bloghua.AutoClient.Desktop.Views.AboutView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      Title="关于">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- 图标 (可选) -->
            <ui:FontIcon Glyph="&#xE946;" FontSize="64" Foreground="#0078D7" Margin="0,0,0,20"/>

            <TextBlock Text="斯华客服AI系统客户端" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="Sihua AI Customer Service Client" FontSize="16" Foreground="Gray" HorizontalAlignment="Center" Margin="0,5,0,20"/>

            <TextBlock Text="Version 1.0.0" HorizontalAlignment="Center" Margin="0,0,0,30"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="官方网站：" VerticalAlignment="Center"/>
                <TextBlock Margin="5,0,0,0" VerticalAlignment="Center">
                    <Hyperlink NavigateUri="http://www.sihuaai.com" RequestNavigate="Hyperlink_RequestNavigate">
                        www.sihuaai.com
                    </Hyperlink>
                </TextBlock>
            </StackPanel>

            <TextBlock Text="© 2024 Sihua AI. All Rights Reserved." 
