<Page x:Class="Bloghua.AutoClient.Desktop.Views.LogView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      Title="会话记录">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 查询栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <ui:AutoSuggestBox x:Name="txtSearchName" PlaceholderText="微信名称" Width="120" Margin="0,0,10,0"/>
            <ui:AutoSuggestBox x:Name="txtSearchContent" PlaceholderText="内容关键词" Width="150" Margin="0,0,10,0"/>

            <DatePicker x:Name="dpStart" Width="120" Margin="0,0,5,0"/>
            <TextBlock Text="-" VerticalAlignment="Center"/>
            <DatePicker x:Name="dpEnd" Width="120" Margin="5,0,10,0"/>

            <Button Content="查询" Click="Search_Click" Margin="0,0,10,0"/>
            <Button Content="导出Excel" Click="Export_Click" Margin="0,0,10,0"/>
            <Button Content="清空所有日志" Click="Clear_Click" Background="#E81123" Foreground="White"/>
        </StackPanel>

        <!-- 数据表 -->
        <DataGrid Grid.Row="1" x:Name="gridLogs" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="时间" Binding="{Binding CreatedAt, StringFormat='MM-dd HH:mm:ss'}" Width="120"/>
                <DataGridTextColumn Header="平台" Binding="{Binding Platform}" Width="60"/>
                <DataGridTextColumn Header="名称" Binding="{Binding SessionName}" Width="100"/>
                <DataGridTextColumn Header="对方内容" Binding="{Binding RequestContent}" Width="250"/>
                <DataGridTextColumn Header="回复内容" Binding="{Binding ReplyContent}" Width="250"/>
                <DataGridTextColumn Header="耗时(ms)" Binding="{Binding TimeTakenMs}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>